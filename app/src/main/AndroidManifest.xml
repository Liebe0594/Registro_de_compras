<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.myapplication">

    <!-- Tus permisos de Internet y ubicación se mantienen igual -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- INICIO DE CAMBIOS -->

        <!-- 1. LoginActivity es ahora la actividad de inicio -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. RegisterActivity declarada -->
        <activity android:name=".RegisterActivity" />

        <!-- 3. MainActivity ya no es la actividad de inicio -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- FIN DE CAMBIOS -->


        <!-- Tus otras actividades (HistorialActivity, MapsActivity) se mantienen igual -->
        <activity android:name=".HistorialActivity" />
        <activity android:name=".MapsActivity" />

    </application>
</manifest>
