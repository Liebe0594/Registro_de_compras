<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/abc_popup_background_mtrl_mult">

    <!-- Fila 1: Nombre de la Tienda y Fecha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_nombre_tienda"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tienda: Walmart"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/text_fecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12/Oct/2023"
            android:textSize="12sp"
            android:textColor="#757575"/>
    </LinearLayout>

    <!-- Fila 2: Dirección -->
    <TextView
        android:id="@+id/text_direccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dirección: Av. Siempre Viva 123"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        android:textColor="#555555"/>

    <!-- Fila 3: Total -->
    <TextView
        android:id="@+id/text_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total: $15000"
        android:textAlignment="textEnd"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:layout_marginTop="8dp"/>

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="8dp"/>

</LinearLayout>
