<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Títulos y Totales en la parte superior -->
    <LinearLayout
        android:id="@+id/layout_totales"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#EEE"
        android:padding="10dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/texto_subtotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subtotal: $0.00"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/texto_ahorro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ahorro: -$0.00"
            android:textColor="#4CAF50"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/texto_total_final"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0.00"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- RecyclerView (Lista de Productos) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_carrito"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_totales"
        android:layout_above="@id/layout_botones"
        android:layout_marginBottom="10dp"/>

    <!-- Botones en la parte inferior -->
    <LinearLayout
        android:id="@+id/layout_botones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <Button
            android:id="@+id/boton_agregar_producto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agregar Producto" />

        <!-- === NUEVO BOTÓN LIMPIAR === -->
        <!-- Color rojo (#D32F2F) para indicar acción de borrado -->
        <Button
            android:id="@+id/boton_limpiar_carrito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Limpiar Carrito"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"/>
        <!-- =========================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/boton_ver_historial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Historial"
                android:layout_marginEnd="5dp"/>

            <Button
                android:id="@+id/boton_finalizar_compra"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Finalizar"
                android:layout_marginStart="5dp"/>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>

